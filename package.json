{
  "name": "store",
  "version": "0.0.0",
  "author": "AYG",
  "type": "module",
  "scripts": {
    "start": "node server",
    "worker": "node server/worker.js",
    "build:client": "vite build --config client/vite.config.js",
    "build:admin": "vite build --config admin/vite.config.js",
    "build:server": "vite build --ssr entry-server.jsx --outDir ../build/server --config client/vite.config.js",
    "build": "npm run build:client && npm run build:admin && npm run build:server",
    "test": "node --test \"tests/**/*.test.js\""
  },
  "dependencies": {
    "@dnd-kit/core": "6.3.1",
    "@dnd-kit/sortable": "10.0.0",
    "@dnd-kit/utilities": "3.2.2",
    "@google-cloud/storage": "8.1.0",
    "@hebcal/core": "6.9.2",
    "@maplibre/maplibre-gl-leaflet": "0.1.4",
    "@turf/area": "7.4.0",
    "@turf/intersect": "7.4.0",
    "@turf/rewind": "7.4.0",
    "@turf/simplify": "7.4.0",
    "@turf/union": "7.4.0",
    "barcode-detector": "3.2.2",
    "bullmq": "6.3.4",
    "compression": "1.8.1",
    "cookie-parser": "1.4.7",
    "cors": "2.8.6",
    "express": "5.2.1",
    "fflate": "^0.8.3",
    "p-limit": "^3.1.0",
    "express-rate-limit": "8.7.0",
    "fast-xml-parser": "5.11.1",
    "helmet": "8.3.0",
    "ioredis": "6.0.0",
    "leaflet": "1.9.4",
    "leaflet-draw": "1.0.4",
    "maplibre-gl": "6.9.0",
    "mongoose": "9.9.5",
    "node-cron": "4.6.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-icons": "5.7.0",
    "react-leaflet": "5.0.0",
    "react-router": "8.3.1",
    "sharp": "0.35.4"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "6.1.1",
    "vite": "8.2.2"
  },
  "imports": {
    "#package.json": "./package.json",
    "#common/*": "./common/*",
    "#server/*": "./server/*"
  }
}
