{
  "name": "store",
  "version": "1.0.12",
  "author": "AYG",
  "type": "module",
  "engines": {
    "node": ">=22.22.0"
  },
  "scripts": {
    "start": "node server",
    "worker": "node server/worker.js",
    "build:client": "vite build --config client/vite.config.js",
    "build:admin": "vite build --config admin/vite.config.js",
    "build:server": "vite build --ssr entry-server.jsx --outDir ../build/server --config client/vite.config.js",
    "build": "npm run build:client && npm run build:admin && npm run build:server",
    "test": "node --test \"tests/**/*.test.js\"",
    "stress": "node scripts/stress/run.js",
    "release": "node scripts/release.js"
  },
  "dependencies": {
    "@dnd-kit/core": "6.3.1",
    "@dnd-kit/sortable": "10.0.0",
    "@dnd-kit/utilities": "3.2.2",
    "@google-cloud/storage": "8.4.0",
    "@hebcal/core": "6.16.0",
    "@maplibre/maplibre-gl-leaflet": "0.1.4",
    "@turf/area": "7.4.0",
    "@turf/intersect": "7.4.0",
    "@turf/rewind": "7.4.0",
    "@turf/simplify": "7.4.0",
    "@turf/union": "7.4.0",
    "barcode-detector": "3.2.3",
    "bullmq": "6.7.5",
    "compression": "1.8.2",
    "cookie-parser": "1.4.7",
    "cors": "2.8.6",
    "exceljs": "^4.4.0",
    "express": "5.3.0",
    "express-rate-limit": "8.7.4",
    "fast-xml-parser": "5.12.0",
    "fflate": "^0.8.3",
    "helmet": "8.3.0",
    "ioredis": "6.0.0",
    "leaflet": "1.9.4",
    "leaflet-draw": "1.0.4",
    "maplibre-gl": "6.18.0",
    "mongoose": "9.12.1",
    "node-cron": "4.6.0",
    "p-limit": "^7.3.3",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-icons": "5.7.0",
    "react-leaflet": "5.0.0",
    "react-router": "8.5.1",
    "sharp": "0.35.5"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "6.3.0",
    "vite": "8.3.8"
  },
  "overrides": {
    "uuid": "^11.1.1"
  },
  "imports": {
    "#package.json": "./package.json",
    "#common/*": "./common/*",
    "#server/*": "./server/*"
  }
}
